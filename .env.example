# =====================================================================
#  Clinic AI Receptionist - settings   (never commit this file!)
#  This is the safe template (.env.example). Copy it to .env and fill it in.
# =====================================================================

# ---------- 1) AI provider (pick ONE block) ----------

# --- OpenAI ---
OPENAI_API_KEY=your-api-key-here
OPENAI_BASE_URL=
LLM_MODEL=gpt-4o-mini

# --- Groq (free tier available) ---
# OPENAI_API_KEY=gsk-your-groq-key-here
# OPENAI_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=llama-3.3-70b-versatile

# --- LM Studio (runs on your own computer, key can be anything) ---
# OPENAI_API_KEY=lm-studio
# OPENAI_BASE_URL=http://localhost:1234/v1
# LLM_MODEL=your-loaded-model-name

# ---------- 2) Calendar ----------

# true  = DEMO mode. Bookings are saved in data/mock_bookings.json. No Google setup needed.
# false = real Google Calendar (needs credentials.json, see README).
MOCK_CALENDAR=true

GOOGLE_CALENDAR_ID=primary
GOOGLE_CREDENTIALS_FILE=credentials.json
GOOGLE_TOKEN_FILE=token.json

# ---------- 3) Clinic schedule ----------
# Use an IANA timezone name, e.g. Asia/Karachi, America/New_York, Europe/London
CLINIC_TIMEZONE=UTC
CLINIC_OPEN=09:00
CLINIC_CLOSE=17:00
SLOT_MINUTES=30
# Monday=0 ... Sunday=6   (0,1,2,3,4,5 = Monday to Saturday)
WORKING_DAYS=0,1,2,3,4,5
MAX_DAYS_AHEAD=60

# ---------- 4) Web server (optional) ----------
HOST=127.0.0.1
PORT=8000
